generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganisationType {
  DRIVER
  TEAM
  AGENCY
  COMMERCIAL_ORGANISATION
}

enum MembershipRole {
  OWNER
  ADMIN
  COMMERCIAL_OPERATOR
  REVIEWER
  READ_ONLY
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum OutreachStrategy {
  LINKEDIN_FIRST
  EMAIL_FIRST
  PARALLEL
  MANUAL
  CUSTOM
}

enum EmailAutomationMode {
  MANUAL
  DRAFT_ONLY
  APPROVED_AUTOMATIC
  FULL_AUTOMATION
}

enum ApprovalMode {
  EVERY_MESSAGE
  INITIAL_ONLY
  HIGH_VALUE_ONLY
  NONE
}

enum TargetMarketType {
  HOME
  COMPETITION
  AUDIENCE
  EXPANSION
  SPONSOR_TARGET
}

enum DiscoveryBriefStatus {
  NEVER_RUN
  RUNNING
  COMPLETED
  FAILED
  PAUSED
}

enum ResearchStatus {
  UNRESEARCHED
  RESEARCHING
  RESEARCHED
  NEED_REVIEW
}

enum ContactDiscoveryStatus {
  NOT_STARTED
  SEARCHING
  CONTACTS_FOUND
  NEEDS_MANUAL_SEARCH
}

enum CommercialStage {
  DISCOVERED
  QUALIFIED
  OUTREACH
  CONVERSATION
  OPPORTUNITY
  WON
  LOST
  PAUSED
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum ContactStatus {
  NOT_CONTACTED
  CONTACTED
  REPLIED
  MEETING_SCHEDULED
  ACTIVE_CONVERSATION
  UNRESPONSIVE
}

enum Department {
  PARTNERSHIPS
  MARKETING
  COMMERCIAL
  SALES
  EXECUTIVE
  MANAGEMENT
  OTHER
}

enum VerificationStatus {
  UNVERIFIED
  PUBLICLY_LISTED
  EMAIL_VERIFIED
  OUTDATED
}

enum ContactPriority {
  PRIMARY
  SECONDARY
  BACKUP
}

enum PreferredChannel {
  EMAIL
  LINKEDIN
  PHONE
  EMAIL_AND_LINKEDIN
  UNKNOWN
}

enum EchoStatus {
  NOT_STARTED
  QUEUED
  DRAFTING
  DRAFT_READY
  APPROVED
  SENT
  PAUSED
  FAILED
}

enum DraftStatus {
  NOT_STARTED
  GENERATING
  DRAFT_READY
  NEEDS_REVISION
  APPROVED
  SENT
  FAILED
}

enum ApprovalStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  NEEDS_CHANGES
}

enum LinkedInStatus {
  NOT_STARTED
  CONNECTION_SENT
  ACCEPTED
  FOLLOW_UP_SENT
  REPLIED
  NO_RESPONSE
  PAUSED
  NOT_INTERESTED
}

enum EmailStatus {
  NOT_STARTED
  DRAFT_CREATED
  QUEUED
  SENT
  REPLIED
  PAUSED
  FAILED
  BOUNCED
  SUPPRESSED
}

enum AgentName {
  ATLAS
  SAGE
  RELAY
  ECHO
  PULSE
  SENTINEL
  NOVA
  FORGE
  SEAL
  ORBIT
  BEACON
  LEDGER
  CONTROL
  THROTTLE
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AutomationJobStatus {
  QUEUED
  DISPATCHED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  DEAD_LETTER
}

enum PipelineRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  CANCELLED
}

enum SourceType {
  PUBLIC_WEB
  COMPANY_WEBSITE
  LINKEDIN
  GOOGLE_SEARCH
  REFERRAL
  TRADE_SHOW
  INDUSTRY_ASSOCIATION
  EXISTING_SPONSOR
  APOLLO
  CLAY
  PERSONAL_NETWORK
  MANUAL
  AIRTABLE_MIGRATION
  AI_GENERATED
  SYSTEM_GENERATED
  GMAIL
}

enum ChannelType {
  LINKEDIN
  EMAIL
  PHONE
}

enum ChannelActionStatus {
  NOT_STARTED
  READY
  QUEUED
  SENT
  ACCEPTED
  FOLLOW_UP_DUE
  REPLIED
  NO_RESPONSE
  PAUSED
  FAILED
  NOT_INTERESTED
  BOUNCED
  SUPPRESSED
}

enum InteractionDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum ReplyIntent {
  POSITIVE_INTEREST
  MORE_INFORMATION
  MEETING_REQUEST
  REFERRAL
  OBJECTION
  NO_BUDGET
  NOT_NOW
  NOT_INTERESTED
  WRONG_CONTACT
  OUT_OF_OFFICE
  UNSUBSCRIBE
  UNKNOWN
}

enum ReplySentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum SentinelStatus {
  NOT_REQUIRED
  QUEUED
  PROCESSING
  CLASSIFIED
  REVIEWED
  FAILED
}

enum NovaStatus {
  NOT_REQUIRED
  QUEUED
  PROCESSING
  READY
  REVIEWED
  REJECTED
  FAILED
}

enum NovaRelationshipAction {
  CONTINUE
  PAUSE
  CLOSE
}

enum NovaResponseChannel {
  EMAIL
  LINKEDIN
  NONE
}

enum OpportunityStage {
  INTERESTED
  DISCOVERY_CALL
  NEEDS_ANALYSIS
  PROPOSAL_REQUESTED
  PROPOSAL_SENT
  NEGOTIATION
  VERBAL_AGREEMENT
  WON
  LOST
  ON_HOLD
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskType {
  MANUAL_ACTION
  LINKEDIN_ACTION
  EMAIL_ACTION
  FOLLOW_UP
  MEETING_PREP
  PROPOSAL
  DATA_REVIEW
  AUTOMATION_RETRY
}

enum IntegrationProvider {
  GMAIL
  GOOGLE_CALENDAR
  OPENAI
  SEARCH_PROVIDER
  SLACK
  WHATSAPP
}

enum IntegrationStatus {
  DISCONNECTED
  CONNECTED
  EXPIRED
  ERROR
}

enum SuppressionReason {
  OPT_OUT
  BOUNCED
  INVALID_ADDRESS
  USER_SUPPRESSED
  LEGAL_RESTRICTION
  ACTIVE_CONVERSATION
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  APPROVE
  REJECT
  LOGIN
  LOGOUT
  INTEGRATION_CONNECT
  INTEGRATION_DISCONNECT
  AUTOMATION_RUN
  EMAIL_SEND
}

enum ReleaseAcceptanceStatus {
  DRAFT
  IN_PROGRESS
  BLOCKED
  READY
  APPROVED
  RELEASED
}

enum AcceptanceCheckStatus {
  PENDING
  PASS
  FAIL
  BLOCKED
  WAIVED
}

enum AcceptanceCheckCategory {
  PRODUCT
  AGENTS
  OUTREACH
  AUTH
  SECURITY
  DATA
  INFRASTRUCTURE
  QA
}

model User {
  id             String                   @id @default(uuid()) @db.Uuid
  email          String                   @unique
  passwordHash   String
  name           String
  status         UserStatus               @default(ACTIVE)
  emailVerifiedAt DateTime?               @db.Timestamptz(3)
  failedLoginCount Int                     @default(0)
  lockedUntil      DateTime?               @db.Timestamptz(3)
  lastLoginAt      DateTime?               @db.Timestamptz(3)
  mfaEnabled       Boolean                 @default(false)
  mfaSecretEncrypted String?
  mfaPendingSecretEncrypted String?
  mfaPendingExpiresAt DateTime?            @db.Timestamptz(3)
  mfaRecoveryCodeHashes Json               @default("[]")
  mfaEnabledAt     DateTime?               @db.Timestamptz(3)
  createdAt      DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                 @updatedAt @db.Timestamptz(3)
  memberships    OrganisationMembership[]
  authSessions   AuthSession[]
  createdCompanies Company[]              @relation("CompanyCreatedBy")
  createdContacts Contact[]                @relation("ContactCreatedBy")
  auditLogs      AuditLog[]
  approvals      ApprovalEvent[]
  invitationsSent OrganisationInvitation[] @relation("OrganisationInvitationInvitedBy")
  invitationsAccepted OrganisationInvitation[] @relation("OrganisationInvitationAcceptedBy")
  passwordResetTokens PasswordResetToken[]
  loginChallenges AuthLoginChallenge[]
  authEmailOutbox AuthEmailOutbox[]
  agentRunReviews AgentRun[] @relation("AgentRunReviewedBy")
  sentinelReviews Interaction[] @relation("SentinelReviewedBy")
  novaReviews     Interaction[] @relation("NovaReviewedBy")
  releaseApprovals ReleaseAcceptance[] @relation("ReleaseAcceptanceApprovedBy")
  acceptanceChecks ReleaseAcceptanceCheck[] @relation("AcceptanceCheckTestedBy")
  startedPipelineRuns PipelineRun[] @relation("PipelineRunStartedBy")
}

model Organisation {
  id                  String                   @id @default(uuid()) @db.Uuid
  name                String
  slug                String                   @unique
  type                OrganisationType         @default(DRIVER)
  createdAt           DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                 @updatedAt @db.Timestamptz(3)
  memberships         OrganisationMembership[]
  driverProfile       DriverProfile?
  onboardingResponses OnboardingResponse[]
  outreachPolicy      OutreachPolicy?
  targetMarkets       TargetMarket[]
  discoveryPreference DiscoveryPreference?
  discoveryBriefs     DiscoveryBrief[]
  companies           Company[]
  contacts            Contact[]
  evidenceSources     EvidenceSource[]
  outreachRecords     OutreachRecord[]
  channelActions      ChannelAction[]
  emailMessages       EmailMessage[]
  suppressions        SuppressionEntry[]
  opportunities       Opportunity[]
  interactions        Interaction[]
  tasks               Task[]
  meetings            Meeting[]
  proposals           Proposal[]
  agentRuns           AgentRun[]
  automationJobs      AutomationJob[]
  jobOutbox            JobOutbox[]
  promptVersions      PromptVersion[]
  statusHistory       StatusHistory[]
  auditLogs           AuditLog[]
  usageLedger         UsageLedger[]
  integrationAccounts IntegrationAccount[]
  leadSources         LeadSource[]
  authSessions        AuthSession[]
  invitations         OrganisationInvitation[]
  loginChallenges     AuthLoginChallenge[]
  releaseAcceptances  ReleaseAcceptance[]
  acceptanceChecks    ReleaseAcceptanceCheck[]
  pipelineRuns        PipelineRun[]
}

model OrganisationMembership {
  id             String         @id @default(uuid()) @db.Uuid
  organisationId String         @db.Uuid
  userId         String         @db.Uuid
  role           MembershipRole @default(COMMERCIAL_OPERATOR)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organisationId, userId])
  @@index([userId])
}

model AuthSession {
  id                   String        @id @default(uuid()) @db.Uuid
  userId               String        @db.Uuid
  activeOrganisationId String?       @db.Uuid
  tokenHash            String        @unique
  expiresAt            DateTime      @db.Timestamptz(3)
  revokedAt            DateTime?     @db.Timestamptz(3)
  userAgent            String?
  ipAddress            String?
  createdAt            DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @db.Timestamptz(3)
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganisation   Organisation? @relation(fields: [activeOrganisationId], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt])
  @@index([activeOrganisationId])
}

model OrganisationInvitation {
  id               String           @id @default(uuid()) @db.Uuid
  organisationId   String           @db.Uuid
  email            String
  role             MembershipRole   @default(COMMERCIAL_OPERATOR)
  tokenHash        String           @unique
  status           InvitationStatus @default(PENDING)
  expiresAt        DateTime         @db.Timestamptz(3)
  invitedByUserId  String           @db.Uuid
  acceptedByUserId String?          @db.Uuid
  acceptedAt       DateTime?        @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)
  organisation     Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  invitedBy        User             @relation("OrganisationInvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  acceptedBy       User?            @relation("OrganisationInvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([organisationId, status])
  @@index([email, status])
  @@index([expiresAt])
}


model PasswordResetToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  tokenHash   String    @unique
  expiresAt   DateTime  @db.Timestamptz(3)
  usedAt      DateTime? @db.Timestamptz(3)
  requestedIp String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AuthLoginChallenge {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @db.Uuid
  organisationId String        @db.Uuid
  tokenHash      String        @unique
  expiresAt      DateTime      @db.Timestamptz(3)
  attempts       Int           @default(0)
  completedAt    DateTime?     @db.Timestamptz(3)
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AuthEmailOutbox {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String?   @db.Uuid
  recipient    String
  template     String
  payload      Json
  status       String    @default("QUEUED")
  attempts     Int       @default(0)
  maxAttempts  Int       @default(5)
  scheduledFor DateTime  @default(now()) @db.Timestamptz(3)
  sentAt       DateTime? @db.Timestamptz(3)
  errorDetails String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, scheduledFor])
}

model DriverProfile {
  id                     String           @id @default(uuid()) @db.Uuid
  tenantId               String           @unique @db.Uuid
  athleteName            String?
  sport                   String?
  currentSeries           String?
  currentTeam             String?
  competitionLevel        String?
  nationality             String?
  countryOfResidence      String?
  homeRegion              String?
  racingHistory           String?
  achievements            String?
  currentProgramme        String?
  futureGoals             String?
  personalStory           String?
  differentiators         String?
  sponsorshipTargetMinor  Int?
  minimumDealMinor        Int?
  maximumDealMinor        Int?
  currency                String           @default("GBP")
  fundingDeadline         DateTime?        @db.Timestamptz(3)
  existingSponsors        Json?
  excludedBrands          Json?
  audienceSummary         String?
  audienceGeography       Json?
  socialProfiles          Json?
  sponsorshipInventory    Json?
  tone                     String?
  preferredLanguages      Json?
  onboardingStatus        OnboardingStatus @default(NOT_STARTED)
  profileVersion          Int              @default(1)
  source                   SourceType       @default(MANUAL)
  createdAt                DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime         @updatedAt @db.Timestamptz(3)
  tenant                   Organisation     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model OnboardingResponse {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @db.Uuid
  userId      String       @db.Uuid
  version     Int          @default(1)
  responses   Json
  completedAt DateTime?    @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  tenant      Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

model OutreachPolicy {
  id                          String              @id @default(uuid()) @db.Uuid
  tenantId                    String              @unique @db.Uuid
  strategy                    OutreachStrategy    @default(LINKEDIN_FIRST)
  emailAutomationMode         EmailAutomationMode @default(DRAFT_ONLY)
  approvalMode                ApprovalMode        @default(EVERY_MESSAGE)
  dailyEmailLimit             Int                 @default(20)
  allowedSendingDays          Json                @default("[1,2,3,4,5]")
  sendingWindowStart          String              @default("09:00")
  sendingWindowEnd            String              @default("17:00")
  timezone                    String              @default("UTC")
  delayBetweenMessagesSeconds Int                 @default(120)
  emailFollowUpCount          Int                 @default(2)
  firstFollowUpDelayDays      Int                 @default(5)
  secondFollowUpDelayDays     Int                 @default(7)
  linkedinAcceptanceDelayDays Int                 @default(1)
  linkedinNoResponseDelayDays Int                 @default(5)
  stopOnReply                 Boolean             @default(true)
  stopOnMeeting               Boolean             @default(true)
  stopOnOptOut                Boolean             @default(true)
  simultaneousCompanyContacts Int                 @default(1)
  highValueApprovalMinor      Int?
  createdAt                   DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime             @updatedAt @db.Timestamptz(3)
  tenant                      Organisation         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model TargetMarket {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @db.Uuid
  country   String
  region    String           @default("")
  type      TargetMarketType
  priority  Int              @default(3)
  rationale String?
  active    Boolean          @default(true)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)
  tenant    Organisation     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, country, region, type])
  @@index([tenantId, active])
}

model DiscoveryPreference {
  id                     String       @id @default(uuid()) @db.Uuid
  tenantId               String       @unique @db.Uuid
  preferredIndustries    Json?
  excludedIndustries     Json?
  preferredCompanySizes  Json?
  preferredCompanyTypes  Json?
  b2bPreference          String?
  localRegionalGlobal    String?
  existingSponsorConflicts Json?
  realisticTargetRule    String?
  createdAt              DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime     @updatedAt @db.Timestamptz(3)
  tenant                 Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model DiscoveryBrief {
  id                    String               @id @default(uuid()) @db.Uuid
  tenantId              String               @db.Uuid
  briefName             String
  active                Boolean              @default(false)
  region                String
  industryFocus         String
  searchTheme           String
  companiesPerRun       Int                  @default(5)
  lastRunAt             DateTime?            @db.Timestamptz(3)
  lastRunStatus         DiscoveryBriefStatus @default(NEVER_RUN)
  lastResultCount       Int                  @default(0)
  atlasNotes            String?
  notes                 String?
  generatedFromOnboarding Boolean            @default(false)
  generationReason      String?
  driverProfileVersion  Int?
  geographicalRationale String?
  source                SourceType           @default(MANUAL)
  createdById           String?              @db.Uuid
  createdAt             DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @db.Timestamptz(3)
  tenant                Organisation         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companies             Company[]
  agentRuns             AgentRun[]
  pipelineRuns          PipelineRun[]

  @@index([tenantId, active])
  @@index([tenantId, lastRunStatus])
}

model Company {
  id                     String                 @id @default(uuid()) @db.Uuid
  tenantId               String                 @db.Uuid
  companyName            String
  industries             String?
  country                String?
  website                String
  companyDomain          String
  companyKey             String
  linkedinCompanyUrl     String?
  companySize            String?
  currentStage           CommercialStage        @default(DISCOVERED)
  priority               Priority?
  nextFollowUpAt         DateTime?              @db.Timestamptz(3)
  lastContactAt          DateTime?              @db.Timestamptz(3)
  companyOwnerId         String?                @db.Uuid
  researchStatus         ResearchStatus         @default(UNRESEARCHED)
  researchNotes          String?
  partnershipAngle       String?
  recommendedContactRoles String?
  lastResearchedAt       DateTime?              @db.Timestamptz(3)
  contactDiscoveryStatus ContactDiscoveryStatus @default(NOT_STARTED)
  contactDiscoveryNotes  String?
  lastContactSearchAt    DateTime?              @db.Timestamptz(3)
  contactsFoundCount     Int                    @default(0)
  discoveryRationale     String?
  discoveryEvidence      String?
  discoveryBriefId       String?                @db.Uuid
  atlasDiscoveredAt      DateTime?              @db.Timestamptz(3)
  confidence             Float?
  evidenceCompleteness   Float?
  source                 SourceType             @default(MANUAL)
  legacyId               String?
  createdById            String?                @db.Uuid
  createdAt              DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime               @updatedAt @db.Timestamptz(3)
  tenant                 Organisation           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy              User?                  @relation("CompanyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  discoveryBrief         DiscoveryBrief?        @relation(fields: [discoveryBriefId], references: [id], onDelete: SetNull)
  score                  CompanyScore?
  contacts               Contact[]
  evidence               CompanyEvidence[]
  outreachRecords        OutreachRecord[]
  opportunities          Opportunity[]
  interactions           Interaction[]
  tasks                  Task[]
  meetings               Meeting[]
  proposals              Proposal[]
  leadSources            CompanyLeadSource[]
  agentRuns              AgentRun[]

  @@unique([tenantId, companyKey])
  @@index([tenantId, researchStatus, priority])
  @@index([tenantId, contactDiscoveryStatus])
}

model CompanyScore {
  id                    String   @id @default(uuid()) @db.Uuid
  companyId             String   @unique @db.Uuid
  budgetPotential       Int
  strategicFit          Int
  geographicalFit       Int
  motorsportRelevance   Int
  marketingActivity     Int
  decisionMakerAccess   Int
  timingScore           Int
  commercialScore       Int
  scoringVersion        Int      @default(1)
  explanation           Json?
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([commercialScore])
}

model Contact {
  id                    String             @id @default(uuid()) @db.Uuid
  tenantId              String             @db.Uuid
  companyId             String             @db.Uuid
  contactName           String
  jobTitle              String
  department            Department         @default(OTHER)
  email                 String?
  phone                 String?
  linkedinProfileUrl    String?
  status                ContactStatus      @default(NOT_CONTACTED)
  lastContactAt         DateTime?          @db.Timestamptz(3)
  nextFollowUpAt        DateTime?          @db.Timestamptz(3)
  notes                 String?
  verificationStatus    VerificationStatus @default(UNVERIFIED)
  lastVerifiedAt        DateTime?          @db.Timestamptz(3)
  externalPersonId      String?
  contactPriority       ContactPriority    @default(BACKUP)
  discoverySource       SourceType         @default(PUBLIC_WEB)
  contactKey            String
  echoStatus            EchoStatus         @default(NOT_STARTED)
  preferredChannel      PreferredChannel   @default(UNKNOWN)
  confidence            Float?
  evidenceCompleteness  Float?
  source                 SourceType         @default(MANUAL)
  legacyId               String?
  createdById            String?            @db.Uuid
  createdAt              DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @db.Timestamptz(3)
  tenant                 Organisation       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company                Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy              User?              @relation("ContactCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  evidence               ContactEvidence[]
  outreachRecords        OutreachRecord[]
  channelActions         ChannelAction[]
  emailMessages          EmailMessage[]
  opportunities          Opportunity[]      @relation("OpportunityPrimaryContact")
  interactions           Interaction[]
  tasks                  Task[]
  meetings               Meeting[]
  agentRuns              AgentRun[]

  @@unique([tenantId, contactKey])
  @@index([tenantId, echoStatus, status])
