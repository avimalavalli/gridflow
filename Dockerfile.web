FROM node:22.16.0-bookworm-slim
WORKDIR /app
ENV NPM_CONFIG_AUDIT=false
ENV NPM_CONFIG_FUND=false

COPY package.json package-lock.json ./
COPY apps ./apps
COPY packages ./packages
COPY scripts ./scripts

RUN npm ci --no-audit --no-fund \
 && npm run build --workspace @gridflow/domain \
 && cd apps/web \
 && NEXT_TELEMETRY_DISABLED=1 npx next build --webpack --experimental-build-mode compile \
 && node ../../scripts/prepare-next-generate.mjs \
 && NEXT_TELEMETRY_DISABLED=1 npx next build --webpack --experimental-build-mode generate

ENV NODE_ENV=production
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/login').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["npm", "run", "start", "--workspace", "@gridflow/web"]
