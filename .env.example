# Local development uses embedded PostgreSQL-compatible PGlite when DATABASE_URL is omitted.
# DATABASE_URL=pglite:///absolute/path/to/gridflow/.gridflow-data/postgres

# Staging / production PostgreSQL
# DATABASE_URL=postgresql://user:password@host:5432/gridflow?sslmode=require
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# API and web
PORT=3001
WEB_ORIGIN=http://localhost:3000
GRIDFLOW_API_URL=http://localhost:3001/api/v1
# Optional second server-side endpoint used only when the primary API connection fails.
GRIDFLOW_API_FALLBACK_URL=
# Backward-compatible alias. GRIDFLOW_API_URL is preferred and is read at runtime by the web service.
# GRIDFLOW_API_PROXY_TARGET=http://localhost:3001/api/v1
TRUST_PROXY=false

# Authentication
# Development bootstrap bypasses login locally only. It is rejected in production.
GRIDFLOW_DEV_BOOTSTRAP=true
GRIDFLOW_DEV_USER_EMAIL=developer@gridflow.local
GRIDFLOW_DEV_USER_NAME=GridFlow Developer
GRIDFLOW_DEV_ORGANISATION_NAME=GridFlow Test Athlete
GRIDFLOW_DEV_ORGANISATION_SLUG=gridflow-test-athlete-local

# OPEN allows anyone to register, CODE uses a shared beta code, ACTIVATION requires an
# email-bound one-time purchase link, and CLOSED disables new organisations.
AUTH_SIGNUP_MODE=OPEN
AUTH_PRIVATE_BETA_CODE=
# Comma-separated account emails allowed to open the private Platform Admin area.
PLATFORM_ADMIN_EMAILS=
AUTH_SESSION_COOKIE_NAME=gridflow_session
AUTH_SESSION_DAYS=30
AUTH_INVITATION_DAYS=7
AUTH_SECURE_COOKIES=false

# GridFlow-managed evidence research for Atlas, Sage and Relay, plus managed Ultra execution.
# Customers never see or provide this server-side key.
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-5-mini
OPENAI_TIMEOUT_MS=900000
# Optional verified price inputs for estimated cost reporting.
OPENAI_INPUT_COST_PER_MILLION_USD=
OPENAI_OUTPUT_COST_PER_MILLION_USD=
AGENT_WORKER_POLL_MS=2000
AGENT_STALE_AFTER_MINUTES=10
# Default model used with each customer's encrypted Gemini free-tier key for Echo,
# Sentinel, Nova and other non-web agents. Customer keys are entered in the app.
GEMINI_AGENT_MODEL=gemini-3.5-flash-lite


# Gmail OAuth and policy-controlled delivery (server-side only)
# Create a Google OAuth Web application and enable the Gmail API.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/v1/integrations/gmail/callback
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTEGRATION_ENCRYPTION_KEY=
# Optional separate HMAC secret; defaults to INTEGRATION_ENCRYPTION_KEY.
GOOGLE_OAUTH_STATE_SECRET=
EMAIL_STALE_AFTER_MINUTES=10

# Account recovery and multi-factor authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_ENCRYPTION_KEY=
AUTH_PASSWORD_RESET_MINUTES=30
AUTH_LOGIN_LOCKOUT_ATTEMPTS=8
AUTH_LOGIN_LOCKOUT_MINUTES=15
AUTH_MFA_CHALLENGE_MINUTES=5
# CONSOLE is development-only. Production requires RESEND.
AUTH_MAIL_PROVIDER=CONSOLE
AUTH_FROM_EMAIL=GridFlow <no-reply@example.com>
RESEND_API_KEY=
AUTH_EMAIL_STALE_AFTER_MINUTES=10

# Release metadata and hard acceptance gates
GRIDFLOW_RELEASE=
GRIDFLOW_COMMIT_SHA=
# Set these only after the exact release commit passes each control.
RELEASE_BUILD_VALIDATED=false
RELEASE_CI_PASSED=false
RELEASE_DEPENDENCY_AUDIT_PASSED=false

# Operations, alerting and recovery
# A generic HTTPS webhook receiving sanitised API/worker failure events. No request bodies or secrets are sent.
OPERATIONS_ALERT_WEBHOOK_URL=
# Set true when the hosting platform forwards structured stdout/stderr logs to an alert-capable log drain.
LOG_DRAIN_CONFIGURED=false
# Local target used by `npm run backup:database`.
BACKUP_DIRECTORY=./backups
# Record the external encrypted storage destination used by the deployment backup job (for readiness checks only).
BACKUP_STORAGE_URL=
# Set true only when the managed PostgreSQL provider supplies tested point-in-time backups.
DATABASE_PROVIDER_BACKUPS=false
BACKUP_RETENTION_DAYS=30
