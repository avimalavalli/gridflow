  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leadSource  LeadSource @relation(fields: [leadSourceId], references: [id], onDelete: Cascade)

  @@id([companyId, leadSourceId])
}

model ReleaseAcceptance {
  id               String                  @id @default(uuid()) @db.Uuid
  tenantId         String                  @db.Uuid
  releaseVersion   String
  commitSha        String?
  environment      String                  @default("production")
  status           ReleaseAcceptanceStatus @default(DRAFT)
  readinessScore   Int                     @default(0)
  notes            String?
  approvedByUserId String?                 @db.Uuid
  approvedAt       DateTime?               @db.Timestamptz(3)
  releasedAt       DateTime?               @db.Timestamptz(3)
  createdAt        DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                @updatedAt @db.Timestamptz(3)
  tenant           Organisation            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  approvedBy       User?                   @relation("ReleaseAcceptanceApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  checks           ReleaseAcceptanceCheck[]

  @@unique([tenantId, releaseVersion])
  @@index([tenantId, status, updatedAt])
}

model ReleaseAcceptanceCheck {
  id                    String                  @id @default(uuid()) @db.Uuid
  tenantId              String                  @db.Uuid
  releaseAcceptanceId   String                  @db.Uuid
  key                   String
  category              AcceptanceCheckCategory
  title                 String
  description           String
  required              Boolean                 @default(true)
  automated             Boolean                 @default(false)
  status                AcceptanceCheckStatus   @default(PENDING)
  notes                 String?
  evidenceUrl           String?
  automatedDetail       String?
  lastEvaluatedAt       DateTime?               @db.Timestamptz(3)
  testedAt              DateTime?               @db.Timestamptz(3)
  testedByUserId        String?                  @db.Uuid
  createdAt             DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                 @updatedAt @db.Timestamptz(3)
  tenant                Organisation             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  releaseAcceptance     ReleaseAcceptance        @relation(fields: [releaseAcceptanceId], references: [id], onDelete: Cascade)
  testedBy              User?                    @relation("AcceptanceCheckTestedBy", fields: [testedByUserId], references: [id], onDelete: SetNull)

  @@unique([releaseAcceptanceId, key])
  @@index([tenantId, status, category])
}

enum MigrationDecision {
  PENDING
  APPROVE
  APPLY_REPAIRS
  SKIP
}

enum MigrationRunStatus {
  PREVIEW
  RUNNING
  SUCCEEDED
  FAILED
}

enum MigrationItemOutcome {
  CREATED
  UPDATED
  SKIPPED
  BLOCKED
  FAILED
}

model MigrationReview {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @db.Uuid
  legacyId    String
  tableName   String
  sourceRow   Int
  decision    MigrationDecision @default(PENDING)
  notes       String?
  decidedById String?           @db.Uuid
  decidedAt   DateTime?         @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)

  @@unique([tenantId, legacyId])
  @@index([tenantId, decision])
}

model MigrationRun {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @db.Uuid
  status            MigrationRunStatus @default(PREVIEW)
  sourceFingerprint String
  sourceDirectory   String
  createdById       String?            @db.Uuid
  startedAt         DateTime?          @db.Timestamptz(3)
  completedAt       DateTime?          @db.Timestamptz(3)
  createdCount      Int                @default(0)
  updatedCount      Int                @default(0)
  skippedCount      Int                @default(0)
  blockedCount      Int                @default(0)
  failedCount       Int                @default(0)
  summary           Json?
  errorDetails      String?
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)
  items             MigrationRunItem[]

  @@index([tenantId, createdAt])
}

model MigrationRunItem {
  id        String               @id @default(uuid()) @db.Uuid
  runId     String               @db.Uuid
  legacyId  String
  tableName String
  outcome   MigrationItemOutcome
  targetId  String?              @db.Uuid
  details   String?
  createdAt DateTime             @default(now()) @db.Timestamptz(3)
  run       MigrationRun         @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, legacyId])
}
