# Local development uses embedded PostgreSQL-compatible PGlite when DATABASE_URL is omitted.
# DATABASE_URL=pglite:///absolute/path/to/gridflow/.gridflow-data/postgres

# Staging / production PostgreSQL
# DATABASE_URL=postgresql://user:password@host:5432/gridflow?sslmode=require
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# API and web
PORT=3001
WEB_ORIGIN=http://localhost:3000
GRIDFLOW_API_URL=http://localhost:3001/api/v1
GRIDFLOW_API_PROXY_TARGET=http://localhost:3001/api/v1
TRUST_PROXY=false

# Authentication
# Development bootstrap bypasses login locally only. It is rejected in production.
GRIDFLOW_DEV_BOOTSTRAP=true
GRIDFLOW_DEV_USER_EMAIL=developer@gridflow.local
GRIDFLOW_DEV_USER_NAME=GridFlow Developer
GRIDFLOW_DEV_ORGANISATION_NAME=GridFlow Test Athlete
GRIDFLOW_DEV_ORGANISATION_SLUG=gridflow-test-athlete-local

# OPEN allows anyone to register, CODE requires the private beta code, CLOSED disables new organisations.
AUTH_SIGNUP_MODE=OPEN
AUTH_PRIVATE_BETA_CODE=
AUTH_SESSION_COOKIE_NAME=gridflow_session
AUTH_SESSION_DAYS=30
AUTH_INVITATION_DAYS=7
AUTH_SECURE_COOKIES=false

# Live Atlas, Sage, Relay and Echo (server-side only)
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-5-mini
OPENAI_TIMEOUT_MS=120000
# Optional verified price inputs for estimated cost reporting.
OPENAI_INPUT_COST_PER_MILLION_USD=
OPENAI_OUTPUT_COST_PER_MILLION_USD=
AGENT_WORKER_POLL_MS=2000
AGENT_STALE_AFTER_MINUTES=10

# Future Gmail integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/integrations/gmail/callback
