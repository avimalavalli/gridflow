FROM oven/bun:1.3.14 AS bun
FROM node:22.16.0-bookworm-slim
WORKDIR /app

# Use Bun only as the package installer to bypass npm's Docker/Railway install crash.
# GridFlow still builds and runs on Node.js.
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
ENV NPM_CONFIG_AUDIT=false
ENV NPM_CONFIG_FUND=false

COPY package.json package-lock.json ./
COPY apps ./apps
COPY packages ./packages
COPY migration ./migration
COPY scripts ./scripts

RUN bun install --linker hoisted --network-concurrency 16 --concurrent-scripts 2 --no-progress \
 && npm run build:packages \
 && npm run build --workspace @gridflow/api

ENV NODE_ENV=production
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD node -e "fetch('http://127.0.0.1:3001/api/v1/health/live').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "apps/api/dist/main.js"]
